{
  "name": "foreman",
  "private": true,
  "version": "0.0.0",
  "description": "Plan-vs-reality ledger for the D3 Cloud ecosystem — React console and MCP server as equal-peer surfaces",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present --filter '!e2e' test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter e2e test",
    "dev:up": "node scripts/dev-env.mjs && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build --wait && pnpm seed:example",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:env": "node scripts/dev-env.mjs",
    "seed:example": "pnpm --filter foreman-server seed:example",
    "import": "pnpm --filter foreman-server import"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
