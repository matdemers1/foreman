{
  "name": "foreman",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:up": "echo 'Phase 0 T-0.2'",
    "dev:down": "docker compose down",
    "seed:example": "pnpm --filter foreman-server seed:example",
    "import": "pnpm --filter foreman-server import",
    "e2e": "playwright test"
  }
}
